# Rendered per-role settings: generated from settings/templates/*.json.in by
# build-prompts.sh, and machine-specific (hook commands carry this checkout's
# absolute path). The templates are the reviewable source.
/settings/role-*.json

# Scratch output from test runs.
/test/.tmp/

# orch v2 working state: candidate and baseline worktrees, and the current
# feature marker. The artifacts these produce live in docs/features/ and ARE
# committed; the worktrees themselves are scratch.
/.orch/
