# Scratch output from test runs.
/test/.tmp/

# orch working state: candidate and baseline worktrees, and the current
# feature marker. The artifacts these produce live in docs/features/ and ARE
# committed; the worktrees themselves are scratch.
/.orch/

# Local, machine-specific Claude Code settings. The project settings that orch
# installs are committed; this is the per-developer override alongside them.
/.claude/settings.local.json

# Feature artifacts belong to the repo orch is pointed AT, not to orch itself.
/docs/features/

# A stray bridge symlink another session created here after v1 was deleted.
# v1 lives at the v1-final tag; install a copy outside the repo instead.
/pipeline
