#!/bin/bash
# orch - the orchestrator CLI.
#
# orch owns no transport. Claude Code ships the coordination layer — a shared,
# file-locked task list and cross-session messaging — so this CLI is the human
# entry point, the attested executor, and nothing else. Writing our own message
# bus is how a pipeline acquires a message-id race and a verification path that
# dead-letters what it already delivered.
#
# What that frees the budget for is the part that usually goes unmeasured:
# whether orchestrating helped at all. `orch report` answers it from recorded
# numbers, and `orch lab` runs the controlled comparison on demand.
#
# Portability: macOS stock /bin/bash 3.2. Dependencies: git, jq.

set -u

ORCH_PROG="$(basename "$0")"
export ORCH_PROG

_self_dir() {
  local src="$0" dir
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  ( cd -P "$(dirname "$src")" && pwd )
}
ORCH_HOME="$(cd -P "$(_self_dir)/.." && pwd)"
export ORCH_HOME

. "$ORCH_HOME/lib/common.sh"

usage() {
  cat <<'EOF'
orch — adaptive orchestration on Claude Code's native coordination primitives.

  orch doctor                          check the §1 operational constraints
  orch init [--profile P]              print the shared environment; write the layers for a profile
  orch layers                          which layers this repository has on
  orch roster                          live sessions, via `claude agents --json`

  orch kickoff --request <file|text>   freeze the run request; the director drives
  orch feature start <F00N> --request <file|text> [--tier T] [--after F,G] [--here]
  orch feature current                 which feature hooks will attribute events to

  orch tier recommend <F> <tier> --why WHY   the tech-lead proposes
  orch tier confirm <F> [--tier T]     the human decides; sizes the crew
  orch tier show <F>                   tier, recommendation, and crew, as JSON
  orch tier crew [F]                   the roles this feature spawns

  orch team start [--feature F]        spawn the run, or a feature's crew
  orch team status                     who is alive, and where
  orch team stop [--all]               close the sessions orch started
  orch team recycle <name>             kill + respawn with the same env (compaction)
  orch audit <F> [--gate G]            spawn a fresh auditor for one gate
  orch spawn <role> [--feature F] [--suffix S] [--cwd D]
  orch peek <name> [--lines N]         read a session's screen
  orch kill <name>

  orch run --feature F --label L -- CMD…      attested execution
  orch evidence verify --feature F --label L [--claim pass|fail] [--fresh]

  orch statement freeze <F> [--why W]  hash the statement; gates hold the feature to it
  orch statement check <F>             exit 6 STATEMENT_MOVED if a frozen file changed
  orch oracle freeze <F> [--sha S]     hash the test tree; the tests that pass must be these
  orch oracle check <F> [--sha S]      exit 7 ORACLE_MOVED if the test tree differs

  orch sensor coverage <F> [--lcov F]  diff coverage from an lcov report; a ledger reading
  orch sensor mutation <F> [--from T]  mutation score from stryker, cargo-mutants, or an attested run
  orch sensor security <F> --class code|deps|iac --sarif FILE   a scanner's SARIF, scoped to the diff, mapped to CWE/OWASP/CIS
  orch sensor perf <F> [--runs N] -- CMD…   the diff's benchmarks against the base's, interleaved, medians
  orch sensor show <F>                 the latest reading of each sensor
  orch security checklist              the security lens's criteria: OWASP Top 10:2025, ASVS 5.0, CWE Top 25, CIS AWS
  orch security asvs [V8 | V8.2 | 8.2.1 | word]   ASVS requirements
  orch security owasp <CWE-n>          which Top 10 categories map a CWE
  orch security cis [section | check]  CIS AWS Foundations recommendations
  orch security top25
  orch axioms <F> [--base B]           new escape hatches in the diff; exit 1 if any
  orch spec coverage <F>               which oracle tests cite each requirement id

  orch gate read <F> <gate>            gate state, as JSON
  orch gate set  <F> <gate> <met|open> [--sha SHA]
  orch gate check <F> <gate>           exit 0 only if met for the current HEAD
  orch holdout add <F> <test-path>     hold a test out of the tree; the developer never sees it
  orch holdout run <F> -- CMD…         run the holdout in a clean worktree at HEAD; a merge gate
  orch holdout list <F>
  orch readback start <F>              a blind session: what do the tests literally assert?
  orch readback record <F> [file|-]    the read-back, bound to the oracle sha
  orch readback files <F>              the oracle files the read-back may read
  orch merge <F> [--close]             land F on the base: gates, lock, integration run, advance
  orch merge status                    approved and waiting, landed, rejected
  orch waves                           the feature graph and each feature's state
  orch waves next [--start]            ready features: refresh from base; start their crews
  orch packet <F>                      what to read before approving: statement first, diff last
  orch approve <F> --gate <gate>       human approval, from any terminal

  orch health signals <F>              which degradation signals are firing
  orch escalate check <F>              escalate if the evidence warrants it
  orch escalate to <F> <rung> [why]    force a rung (one-way)

  orch findings add <F> --raised-by R --severity S --file P --line N \
                        --claim C --consequence Q
  orch findings deliver <F>            the verbatim text for the developer's next turn
  orch findings dispute <F> <id> --reason WHY
  orch findings verify <F>             classify open findings; prints uptake
  orch findings yield [F|--all]        per-reviewer unique-find rate
  orch review scope [F]                a re-review's packet: open findings + the
                                       diff since the last verdict, nothing else

  orch refactor check <F>              should the refactor pass run? (rung, diff size, metrics)
  orch refactor start <F>              worktree + fresh developer, design only; records the exit numbers
  orch refactor finish <F>             keep (fast-forward) or discard, mechanically

  orch upkeep scan [--top N]           repo-wide census: hatches, stale tests, churn, uncovered — ranked
  orch upkeep plan [--top N]           the top files become upkeep features
  orch upkeep night [--top N]          a refactor pass per file, in parallel, landing on branches
  orch upkeep morning                  what held; then  orch upkeep keep|discard <F>
  orch upkeep telemetry [--top N] [--start]   production error clusters and latency, from an attested run, become features

  orch product trace                   persona -> story -> feature -> state; orphans exit 1
  orch product freeze [--why W]        hash the personas and stories; check exits 9 if one moved
  orch product plan [--story S]        one feature per story, the request written from the story
  orch product night [--budget N]      plan, then crew every ready feature, in parallel
  orch product morning                 each feature: the walkthrough first, then the numbers
  orch product keep <F> [--exploratory] | iterate <F> --note T | discard <F> --why W
  orch product personas                each persona, its stories, what the mornings taught it
  orch product metrics                 the loop: readings, guardrails, each kept feature's hypothesis, proposals
  orch walkthrough start <F>           a fresh session as the persona, blind to the code
  orch walkthrough record <F> --outcome done|blocked --steps N [--minutes M] [--note T]
  orch walkthrough status <F>

  orch candidates start <F> [-n N]     rung 3: N isolated worktrees
  orch candidates collect <F> [gates…] gather each candidate's own attestations
  orch candidates select <F>           mechanical selection; prints the winner
  orch candidates clean <F> [--keep C]

  orch diagnose start <F> <finding> [-k K]    rung 4: K competing hypotheses
  orch diagnose predict <F> <k> --prediction P --command CMD
  orch diagnose run <F>                execute every prediction; results select

  orch status render|show [F]          status.md, generated from the ledger
  orch decision record <F> --text T [--why W] [--kind dead-end] [--evidence LABEL]   a decision, or a dead end, as a ledger event
  orch decision list [F]
  orch decision deadends [F]           what was tried and failed — carried into every developer's orders

  orch report [F|--all]                cost, uptake, gate yield
  orch watch                           live state; no terminal UI, works over SSH

  orch lab baseline <F> [-- gate-cmd…] opt-in: attempt F solo, for comparison
  orch lab ablation [F|--all]          the comparison, once baselines exist

  orch post <to> <body>                durable notify (agents use SendMessage)
  orch task claim <id> <owner> | release <id>
  orch version
EOF
}

# --------------------------------------------------------------------------
# Argument helpers. bash 3.2: no associative arrays, so flags are scanned.
# --------------------------------------------------------------------------

# opt <name> <default> -- "$@"  -> prints the value of --name, or the default.
opt() {
  local name="$1" def="$2"; shift 2
  while [ "$#" -gt 0 ]; do
    case "$1" in
      "--$name") printf '%s' "${2-}"; return 0 ;;
      "--$name="*) printf '%s' "${1#--$name=}"; return 0 ;;
    esac
    shift
  done
  printf '%s' "$def"
}

has_flag() {
  local name="$1"; shift
  while [ "$#" -gt 0 ]; do [ "$1" = "--$name" ] && return 0; shift; done
  return 1
}

need() { [ -n "${1:-}" ] || die "$2"; printf '%s' "$1"; }

# --------------------------------------------------------------------------

cmd="${1:-}"; [ "$#" -gt 0 ] && shift

case "$cmd" in ''|-h|--help|help) usage; exit 0 ;; esac
[ "$cmd" = version ] && { printf 'orch %s (substrate verified on claude %s)\n' "$ORCH_VERSION" "$ORCH_VERIFIED_CLI"; exit 0; }

require_cmd git
require_cmd jq

# Which feature this invocation is about, from `--feature F` or a positional
# feature id, so the repo resolves to that feature's worktree before any
# command runs. A crew session has ORCH_FEATURE from its launcher already;
# this is for the human's and the director's terminal in the main checkout.
_prev=''
{
  for _a in "$@"; do
    if [ "$_prev" = "--feature" ] || orch_valid_feature "$_a" 2>/dev/null; then
      case "$_a" in F[0-9][0-9][0-9]*) export ORCH_FEATURE="$_a"; break ;; esac
    fi
    case "$_a" in --feature=F*) export ORCH_FEATURE="${_a#--feature=}"; break ;; esac
    _prev="$_a"
  done
  unset _prev _a
}
orch_require_repo

case "$cmd" in

  doctor)
    . "$ORCH_HOME/lib/doctor.sh"
    doctor_run
    ;;

  layers)
    . "$ORCH_HOME/lib/layers.sh"
    printf 'layers on: %s\n' "$(layers_enabled)"
    [ -r "$(layers_path)" ] && printf 'from %s\n' "$(layers_path)" || printf '(no %s — the default: floor and crew)\n' "$(layers_path)"
    ;;

  init)
    . "$ORCH_HOME/lib/substrate/base.sh"
    . "$ORCH_HOME/lib/layers.sh"
    prof="$(opt profile '' "$@")"
    if [ -n "$prof" ]; then
      ls="$(layers_profile "$prof")" || die "init: --profile must be library, service, or product (got '$prof')"
      layers_write $ls
      printf 'wrote %s: layers %s\n\n' "$(layers_path)" "$ls"
    fi
    cat <<EOF
Every session in an orch team must share these, or they coordinate with nobody:

  export CLAUDE_CODE_TASK_LIST_ID=orch-$(basename "$ORCH_REPO")
  export CLAUDE_PROJECT_DIR=$ORCH_REPO
  PATH=$ORCH_HOME/bin:\$PATH

And every session must launch in the SAME permission-mode class. A message
between mismatched classes is held for approval and dropped after dialogExpiry
(default 5m), so a mixed team does not error — it goes quiet.

In .claude/settings.json:

  { "crossSessionInbound": "accept" }

Then:  orch doctor
EOF
    ;;

  roster)
    . "$ORCH_HOME/lib/substrate/base.sh"
    substrate_roster | jq '.'
    ;;

  post)
    . "$ORCH_HOME/lib/substrate/base.sh"
    to="$(need "${1:-}" 'post: needs a recipient')"
    body="$(need "${2:-}" 'post: needs a body')"
    substrate_post "$to" "$body"
    printf 'posted to %s (durable inbox; a message is never load-bearing)\n' "$to"
    ;;

  task)
    . "$ORCH_HOME/lib/substrate/base.sh"
    sub="${1:-}"; shift 2>/dev/null || true
    case "$sub" in
      claim)   substrate_claim_task "$(need "${1:-}" 'task claim: needs an id')" "${2:-$(orch_actor)}" ;;
      release) substrate_release_task "$(need "${1:-}" 'task release: needs an id')" ;;
      *) die "task: expected claim or release" ;;
    esac
    ;;

  feature)
    sub="${1:-}"; shift 2>/dev/null || true
    case "$sub" in
      start)
        f="$(need "${1:-}" 'feature start: needs a feature id like F001-parser')"; shift
        orch_valid_feature "$f" || die "feature start: '$f' is not a valid feature id (F00N-slug)"
        . "$ORCH_HOME/lib/tier.sh"
        t="$(opt tier '' "$@")"
        [ -z "$t" ] || tier_valid "$t" || die "feature start: '$t' is not a tier (expected: $ORCH_TIERS)"
        req="$(opt request '' "$@")"
        [ -n "$req" ] || die "feature start: --request is required. The crew needs to know what
you are asking for, and freezing it means the tech-lead's requirements.md can
be compared against what you actually said.

  orch feature start $f --request docs/specs/thing.md
  orch feature start $f --request \"Parse the CSV export, tolerate BOM headers\""

        after="$(opt after '' "$@")"
        for dep in $(printf '%s' "$after" | tr ',' ' '); do
          orch_valid_feature "$dep" || die "feature start: --after names '$dep', which is not a feature id"
          [ "$dep" != "$f" ] || die "feature start: a feature cannot depend on itself"
        done
        orch_set_current_feature "$f"
        base="$(opt base "$(escalate_base_branch)" "$@")"
        printf '%s\n' "$base" > "$(orch_state_dir)/base-branch"
        [ -r "$req" ] && reqsrc="$req" || reqsrc="(inline)"

        # A branch per feature, in a worktree per feature. Features run in
        # parallel, so nothing checks out in the main checkout: the feature's
        # crew works in .orch/worktrees/<F>/main and the human's checkout is
        # left alone. --here keeps the old behaviour (check out in place) for
        # a repo that wants one feature at a time.
        # feature/<F>, not orch/<F>: best-of-N candidates take refs under
        # orch/<F>/cN, and git cannot hold both a branch named orch/<F> and a
        # directory of refs beneath it.
        br="$(opt branch "feature/$f" "$@")"
        main="$(orch_main_repo)"
        wt="$main/.orch/worktrees/$f/main"
        if has_flag here "$@"; then
          if [ "$(git -C "$main" rev-parse --abbrev-ref HEAD 2>/dev/null)" = "$br" ]; then
            note "already on $br"
          elif git -C "$main" rev-parse --verify --quiet "$br" >/dev/null 2>&1; then
            git -C "$main" checkout -q "$br" || die "feature start: could not switch to $br"
          else
            git -C "$main" checkout -q -b "$br" || die "feature start: could not create $br"
          fi
        elif [ -d "$wt" ]; then
          note "worktree for $f already exists at $wt"
        else
          mkdir -p "$(dirname "$wt")"
          git -C "$main" worktree prune >/dev/null 2>&1
          if git -C "$main" rev-parse --verify --quiet "$br" >/dev/null 2>&1; then
            git -C "$main" worktree add -f -q "$wt" "$br" || die "feature start: could not add worktree for $br"
          else
            git -C "$main" worktree add -q -b "$br" "$wt" "$base" 2>/dev/null \
              || git -C "$main" worktree add -q -b "$br" "$wt" HEAD \
              || die "feature start: could not create $br"
          fi
        fi
        # The feature's artifacts live in its tree from here on. Freeze the
        # request there: a file is copied rather than referenced, because the
        # point of freezing is that editing your spec mid-run cannot silently
        # change what the crew was asked for.
        export ORCH_FEATURE="$f"; ORCH_REPO="$(orch_repo_root)"; export ORCH_REPO
        mkdir -p "$(orch_feature_dir "$f")"
        if [ -r "$req" ]; then cp "$req" "$(orch_feature_dir "$f")/request.md"
        else printf '%s\n' "$req" > "$(orch_feature_dir "$f")/request.md"; fi

        ORCH_LEDGER_FEATURE="$f" ledger_append feature.started \
          base "$base" branch "$br" request "$reqsrc" rung:raw 0 after "$after"
        printf '%s started on branch %s (base %s)%s.\n' "$f" "$br" "$base" "$([ -d "$wt" ] && printf ' in %s' "$wt")"
        # "Frozen" is a hash in the ledger, not a promise: every gate
        # recomputes it, and a request.md edited afterwards is STATEMENT_MOVED.
        . "$ORCH_HOME/lib/statement.sh"
        statement_freeze "$f" "feature start" >/dev/null
        printf 'request frozen at %s\n' "$(orch_feature_dir "$f")/request.md"
        [ -z "$after" ] || printf 'after %s — its crew starts when they have landed:  orch waves next\n' "$after"
        if [ -n "$t" ]; then
          tier_confirm "$f" "$t"
        else
          printf '\nNo tier yet, so no crew yet. Summon the tech-lead to read the request:\n'
          printf '  orch spawn tech-lead --feature %s\n' "$f"
          printf 'It writes requirements.md and proposes a tier (orch tier recommend); you decide:\n'
          printf '  orch tier confirm %s\n' "$f"
          printf 'then crew up:\n  orch team start --feature %s\n' "$f"
        fi
        ;;
      current) orch_current_feature; printf '\n' ;;
      *) die "feature: expected start or current" ;;
    esac
    ;;

  tier)
    . "$ORCH_HOME/lib/tier.sh"
    sub="${1:-}"; shift 2>/dev/null || true
    case "$sub" in
      recommend)
        f="$(need "${1:-}" 'tier recommend: needs a feature')"; shift
        t="$(need "${1:-}" "tier recommend: needs a tier ($ORCH_TIERS)")"; shift
        tier_recommend "$f" "$t" "$(opt why '' "$@")"
        ;;
      confirm)
        f="$(need "${1:-}" 'tier confirm: needs a feature')"; shift
        tier_confirm "$f" "$(opt tier '' "$@")"
        ;;
      show) tier_show "${1:-$(orch_current_feature)}" | jq '.' ;;
      crew) tier_crew "$(escalate_rung "${1:-$(orch_current_feature)}")"; printf '\n' ;;
      *) die "tier: expected recommend, confirm, show, or crew" ;;
    esac
    ;;

  spawn)
    . "$ORCH_HOME/lib/layers.sh"; layer_require crew
    . "$ORCH_HOME/lib/launcher/base.sh"
    . "$ORCH_HOME/lib/tier.sh"
    role="$(need "${1:-}" 'spawn: needs a role')"; shift 2>/dev/null || true
    f="$(opt feature '' "$@")"
    # A reviewer spawned by hand still gets a lens, and the lens's model: the
    # yield report groups by lens, and a reviewer with none is invisible to it.
    lens="$(opt lens '' "$@")"
    if [ "$role" = "code-reviewer" ]; then
      [ -n "$lens" ] || lens="$(set -- $(tier_lenses); printf '%s' "$1")"
      export ORCH_LENS="$lens" ORCH_MODEL="${ORCH_MODEL:-$(tier_lens_model "$lens")}"
    fi
    name="$(launcher_session_name "$role" "$(opt suffix "${lens:-}" "$@")")"
    # Attributed explicitly. Falling through to orch_current_feature would bill
    # a run-level session to whichever feature happened to be started last.
    ORCH_LEDGER_FEATURE="${f:-_orch}" \
      ORCH_PROMPT="${ORCH_PROMPT:-$(launcher_orders "$role" "$f")}" \
      launcher_spawn "$role" "$name" "$(opt cwd "$ORCH_REPO" "$@")" \
        $(launcher_env "$role" "$f")
    ;;

  kickoff)
    # The one-command entry point, and the piece the first run showed was
    # missing: v1 took a single KICKOFF signal and the conductor drove the
    # whole session; this is that, on the new substrate. Freeze the run
    # request, spawn the director with decompose-and-drive orders, done —
    # every further spawn, gate and merge is the director working its role,
    # and the human is needed exactly where the gates say so.
    . "$ORCH_HOME/lib/layers.sh"; layer_require crew
    . "$ORCH_HOME/lib/launcher/base.sh"
    req="$(opt request '' "$@")"
    [ -n "$req" ] || die 'kickoff: --request is required — a run needs to know what it is building.
  orch kickoff --request docs/specs/my-design.md
  orch kickoff --request "one paragraph of what you want"'
    mkdir -p "$(orch_feature_dir _orch)"
    if [ -r "$req" ]; then cp "$req" "$(orch_feature_dir _orch)/request.md"; reqsrc="$req"
    else printf '%s\n' "$req" > "$(orch_feature_dir _orch)/request.md"; reqsrc='(inline)'
    fi
    ORCH_LEDGER_FEATURE=_orch ledger_append kickoff request "$reqsrc"
    # A director already up predates this request and is holding stale orders;
    # replace it. It is stateless relative to the ledger, so this costs one
    # re-read — and a kickoff the human just issued outranks whatever it was
    # standing by for.
    for n in $(launcher_list); do
      [ "$n" = "director" ] && { launcher_kill director || true; }
    done
    ORCH_LEDGER_FEATURE=_orch \
      ORCH_PROMPT="$(launcher_orders director)" \
      launcher_spawn director "$(launcher_session_name director)" "$ORCH_REPO" \
        $(launcher_env director)
    printf '\nThe run is kicked off. The director decomposes the request and drives;\n'
    printf 'you are needed at the gates it names:\n'
    printf '  orch tier confirm <F>              each feature'"'"'s cost, before any crew\n'
    printf '  orch approve <F> --gate human      each merge\n'
    printf '\nWatch:  orch watch   ·   orch team status   ·   the orch:* workspaces\n'
    ;;

  audit)
    # An auditor exists for the length of one gate. Spawning it fresh is not a
    # cost-saving trick that happens to work — fresh context is the property an
    # adversarial reviewer is supposed to have, and a session-long auditor
    # slowly becomes a colleague. Everything it needs to know is in the ledger
    # and the artifacts; everything it should not know is in the crew's heads.
    . "$ORCH_HOME/lib/layers.sh"; layer_require crew
    . "$ORCH_HOME/lib/launcher/base.sh"
    f="$(need "${1:-}" 'audit: needs a feature')"; shift 2>/dev/null || true
    orch_valid_feature "$f" || die "audit: invalid feature '$f'"
    [ -d "$(orch_feature_dir "$f")" ] || die "audit: $f has no artifacts to audit — orch did not start it"
    g="$(opt gate work "$@")"
    ORCH_LEDGER_FEATURE="$f" ORCH_EFFORT=xhigh \
      ORCH_PROMPT="$(launcher_orders auditor "$f" "$g")" \
      launcher_spawn auditor "$(launcher_session_name auditor)" "$ORCH_REPO" \
        $(launcher_env auditor "$f") "ORCH_GATE=$g"
    ORCH_LEDGER_FEATURE="$f" ledger_append audit.opened gate "$g"
    printf '\nauditor is up for %s, gate `%s`, at xhigh effort, with fresh context.\n' "$f" "$g"
    printf 'When its verdict is on disk (gate set, or findings raised):\n'
    printf '  orch kill auditor\n'
    ;;

  peek)
    . "$ORCH_HOME/lib/launcher/base.sh"
    launcher_peek "$(need "${1:-}" 'peek: needs a session name')" "$(opt lines 60 "$@")"
    ;;

  kill)
    . "$ORCH_HOME/lib/launcher/base.sh"
    launcher_kill "$(need "${1:-}" 'kill: needs a session name')"
    ;;

  team)
    . "$ORCH_HOME/lib/layers.sh"; layer_require crew
    . "$ORCH_HOME/lib/launcher/base.sh"
    . "$ORCH_HOME/lib/tier.sh"
    . "$ORCH_HOME/lib/substrate/base.sh"
    sub="${1:-}"; shift 2>/dev/null || true
    case "$sub" in
      start)
        f="$(opt feature '' "$@")"
        if [ -z "$f" ]; then
          # The run, not a feature — and the run is ONE session. The auditor is
          # no longer session-long: v1's arbiter spent 1.32M tokens mostly
          # idle between gates, accruing exactly the context an adversarial
          # reviewer is not supposed to have. `orch audit` spawns it fresh at
          # each gate; the ledger, not its memory, is the continuity.
          # Success is the spawn's, not this line's: a director that did not
          # launch is a run that is not up, and saying otherwise cost a night.
          ORCH_LEDGER_FEATURE=_orch \
            ORCH_PROMPT="$(launcher_orders director)" \
            launcher_spawn director "$(launcher_session_name director)" "$ORCH_REPO" \
              $(launcher_env director) \
            || die "team start: the director did not launch (the launcher said why above). Nothing is running.
  orch doctor            # the launcher section
  ORCH_LAUNCHER=bg orch team start    # to bypass cmux for now"
          printf '\nThe run is up. The auditor is not a standing session — it is\n'
          printf 'spawned fresh at each gate by `orch audit`. Start a feature next:\n'
          printf '  orch feature start F001-<slug> --request "..."\n'
        else
          orch_valid_feature "$f" || die "team start: '$f' is not a valid feature id"
          tier_is_confirmed "$f" || die "team start: $f has no confirmed tier, so there is no crew to size.
  orch tier recommend $f <$(printf '%s' "$ORCH_TIERS" | tr ' ' '|')> --why \"...\"
  orch tier confirm $f"
          . "$ORCH_HOME/lib/waves.sh"
          blk="$(waves_blockers "$f")"
          [ -z "$blk" ] || die "team start: $f waits for $blk to land first (orch waves)"
          rung="$(escalate_rung "$f")"
          crew="$(tier_crew "$rung")"
          [ -n "$crew" ] || die "team start: $f is at rung 5 — it is yours, not a crew's"
          eff="$(tier_effort "$rung")"
          for r in $crew; do
            if [ "$r" = "code-reviewer" ]; then
              # The ensemble: one session per lens, named by it, and one lens
              # on opus. A subshell per spawn so the lens and model reach the
              # orders, the env and the ledger row without leaking into the
              # next role's spawn.
              for lens in $(tier_lenses "$rung"); do
                ( export ORCH_LENS="$lens" ORCH_MODEL="$(tier_lens_model "$lens")"
                  ORCH_LEDGER_FEATURE="$f" ORCH_EFFORT="$eff" \
                    ORCH_PROMPT="$(launcher_orders "$r" "$f")" \
                    launcher_spawn "$r" "$(launcher_session_name "$r" "$lens")" "$ORCH_REPO" \
                      $(launcher_env "$r" "$f") ) || true
              done
              continue
            fi
            ORCH_LEDGER_FEATURE="$f" ORCH_EFFORT="$eff" \
              ORCH_PROMPT="$(launcher_orders "$r" "$f")" \
              launcher_spawn "$r" "$(launcher_session_name "$r")" "$ORCH_REPO" \
                $(launcher_env "$r" "$f") || true
          done
          printf '\ncrew up for %s at tier `%s`.\n' "$f" "$(tier_current "$f")"
        fi
        ;;
      status)
        printf 'launcher: %s\n' "$(launcher_name)"
        printf '\nstarted by orch:\n'
        launcher_list | sed 's/^/  /' | grep . || printf '  (none)\n'
        printf '\nregistered with the platform:\n'
        substrate_roster | jq -r 'if length==0 then "  (none)" else .[] | "  \(.name // .sessionId)  \(.status // "?")  \(.cwd)" end'
        # A compacted session is quietly degraded: it works, it answers, and it
        # half-remembers. Name the sessions it happened to, because "recycle on
        # compaction" is only a policy if someone can see when it applies.
        compacted="$(ledger_read --all | jq -r -s '
          [.[] | select(type=="object" and .event=="health.compaction") | .session]
          | unique | map(select(length>0)) | .[]' 2>/dev/null)"
        if [ -n "$compacted" ]; then
          hits="$(substrate_roster | jq -r --arg c "$compacted" '
            ($c | split("\n")) as $ids
            | [.[] | select(.sessionId as $s | $ids | index($s)) | .name // .sessionId]
            | join(", ")' 2>/dev/null)"
          if [ -n "$hits" ]; then
            printf '\ncompacted since spawn — running on a degraded context:\n'
            printf '  %s\n' "$hits"
            printf '  recycle rather than ride it out:  orch team recycle <name>\n'
          fi
        fi
        ;;
      stop)
        for n in $(launcher_list); do launcher_kill "$n" || true; done
        ;;
      recycle)
        # For a session whose own context has degraded — compaction being the
        # signal that matters. Agents are stateless relative to the ledger and
        # the artifacts, so a respawn costs one re-read of the slice that
        # matters; surviving on a compacted context costs every turn after it.
        n="$(need "${1:-}" 'team recycle: needs a session name')"
        # The spawn env is reconstructed from the ledger, not remembered by
        # this process: recycle has to work from any terminal, including one
        # opened after the machine rebooted.
        # agent.printed counts too: under the print launcher a "recycle" is a
        # re-print, which is exactly what that launcher means by spawning.
        row="$(ledger_read --all | jq -c -s --arg n "$n" '
          [.[] | select(type=="object"
                        and (.event=="agent.spawned" or .event=="agent.printed")
                        and .name==$n)]
          | if length==0 then empty else .[-1] end' 2>/dev/null)"
        [ -n "$row" ] || die "team recycle: no agent.spawned record for '$n' — orch did not start it"
        role="$(printf '%s' "$row" | jq -r '.role')"
        rf="$(printf '%s' "$row" | jq -r '.feature')"
        [ "$rf" = "_orch" ] && rf=''
        # Same lens, same model: a reviewer recycled onto a different lens
        # would carry its findings' raised_by with it and corrupt the yield.
        lens="$(printf '%s' "$row" | jq -r '.lens // ""')"
        model="$(printf '%s' "$row" | jq -r '.model // ""')"
        [ -n "$lens" ] && export ORCH_LENS="$lens"
        [ -n "$model" ] && export ORCH_MODEL="$model"
        launcher_kill "$n" || true
        eff=''
        if [ -n "$rf" ]; then
          . "$ORCH_HOME/lib/tier.sh"
          eff="$(tier_effort "$(escalate_rung "$rf")")"
        fi
        ORCH_LEDGER_FEATURE="${rf:-_orch}" ORCH_EFFORT="$eff" \
          ORCH_PROMPT="$(launcher_orders "$role" "$rf")" \
          launcher_spawn "$role" "$n" "$ORCH_REPO" $(launcher_env "$role" "$rf")
        ORCH_LEDGER_FEATURE="${rf:-_orch}" ledger_append agent.recycled name "$n" role "$role"
        printf '%s recycled: fresh context, same role, same coordination env.\n' "$n"
        printf 'It resumes from the ledger and the artifacts — that is the design, not a hope.\n'
        ;;
      *) die "team: expected start, status, stop, or recycle" ;;
    esac
    ;;

  status)
    . "$ORCH_HOME/lib/status.sh"
    sub="${1:-render}"; shift 2>/dev/null || true
    case "$sub" in
      render) status_render "${1:-$(orch_current_feature)}" >/dev/null
              printf 'rendered %s\n' "$(status_path "${1:-$(orch_current_feature)}")" ;;
      show)   status_render "${1:-$(orch_current_feature)}" ;;
      *) die "status: expected render or show" ;;
    esac
    ;;

  decision)
    . "$ORCH_HOME/lib/status.sh"
    sub="${1:-}"; shift 2>/dev/null || true
    case "$sub" in
      record)
        f="$(need "${1:-}" 'decision record: needs a feature')"; shift
        decision_record "$f" "$(opt text '' "$@")" "$(opt why '' "$@")" "$(opt kind decision "$@")" "$(opt evidence '' "$@")"
        ;;
      deadends) . "$ORCH_HOME/lib/status.sh"; decision_deadends "${1:-$(orch_current_feature)}"; printf '\n' ;;
      list) decision_list "${1:-$(orch_current_feature)}" ;;
      *) die "decision: expected record, list, or deadends" ;;
    esac
    ;;

  run)
    . "$ORCH_HOME/lib/evidence.sh"
    f="$(opt feature "$(orch_current_feature)" "$@")"
    l="$(opt label '' "$@")"
    [ -n "$l" ] || die 'run: --label is required (it is what an approval cites)'
    # Collect the command after `--` as an array, so quoting survives.
    args=(); seen=0
    for a in "$@"; do
      if [ "$seen" = "1" ]; then args+=("$a"); elif [ "$a" = "--" ]; then seen=1; fi
    done
    [ "$seen" = "1" ] && [ "${#args[@]}" -gt 0 ] || die 'run: no command after `--`'
    evidence_run "$f" "$l" -- "${args[@]}"
    ;;

  evidence)
    . "$ORCH_HOME/lib/evidence.sh"
    sub="${1:-}"; shift 2>/dev/null || true
    case "$sub" in
      verify)
        f="$(opt feature "$(orch_current_feature)" "$@")"
        l="$(opt label '' "$@")"
        [ -n "$l" ] || die 'evidence verify: --label is required'
        set -- "$f" "$l" --claim "$(opt claim pass "$@")" $(has_flag fresh "$@" && printf -- --fresh)
        evidence_verify "$@"
        ;;
      show)
        f="$(opt feature "$(orch_current_feature)" "$@")"
        cat "$(evidence_path "$f")" 2>/dev/null | jq -c '.'
        ;;
      *) die "evidence: expected verify or show" ;;
    esac
    ;;

  sensor)
    . "$ORCH_HOME/lib/sensors.sh"
    sub="${1:-}"; shift 2>/dev/null || true
    f="$(need "${1:-}" 'sensor: needs a feature')"; shift 2>/dev/null || true
    case "$sub" in
      coverage)
        r="$(sensor_coverage "$f" "$@")" || exit 1
        printf '%s' "$r" | jq -r '"diff coverage: \(.pct // "—")% of \(.lines) changed executable lines at \(.sha[0:12])"
          + (if (.unmeasured|length) > 0 then "\n  unmeasured (no test imported them): " + (.unmeasured|join(", ")) else "" end)
          + (if (.uncovered|length) > 0 then "\n  uncovered: " + (.uncovered|join(", ")) else "" end)'
        ;;
      mutation)
        r="$(sensor_mutation "$f" "$@")" || exit 1
        printf '%s' "$r" | jq -r '"mutation score: \(.pct // "—")% (\(.from), scope \(.scope)" + (if .total != null then ", \(.killed)/\(.total) killed" else "" end) + ") at \(.sha[0:12])"'
        ;;
      security)
        . "$ORCH_HOME/lib/security.sh"
        r="$(sensor_security "$f" "$@")" || exit 1
        printf '%s' "$r" | jq -r '"security-\(.class): \(.new) new finding(s) in the diff, \(.top25) CWE Top 25, \(.pre_existing) pre-existing (\(.tool)) at \(.sha[0:12]); \(.open) security finding(s) open"'
        ;;
      perf)
        . "$ORCH_HOME/lib/perf.sh"
        r="$(sensor_perf "$f" "$@")" || exit 1
        printf '%s' "$r" | jq -r '"perf: worst \(.worst_pct)% (\(.worst // "-")) over \(.runs) interleaved runs at \(.sha[0:12])"'
        printf '%s' "$r" | jq -r '.rows[] | "  \(.name)  \(.base) -> \(.head)  \(if .pct > 0 then "+" else "" end)\(.pct)%  spread \(.noise_pct)%\(if .over_budget then "  OVER BUDGET \(.budget)" else "" end)"'
        ;;
      show)
        for s in diff_coverage mutation perf; do
          r="$(sensor_latest "$f" "$s")"
          [ -n "$r" ] && printf '%s' "$r" | jq -c '{sensor: .event, at_sha, pct, ts}' || printf '{"sensor":"sensor.%s","reading":null}\n' "$s"
        done
        . "$ORCH_HOME/lib/security.sh"
        for s in $ORCH_SECURITY_CLASS_LIST; do
          r="$(security_latest "$f" "$s")"
          [ -n "$r" ] && printf '%s' "$r" | jq -c '{sensor: "sensor.security", class, at_sha, new, top25, pre_existing, ts}' || printf '{"sensor":"sensor.security","class":"%s","reading":null}\n' "$s"
        done
        ;;
      *) die "sensor: expected coverage, mutation, security, perf, or show" ;;
    esac
    ;;

  security)
    . "$ORCH_HOME/lib/security.sh"
    sub="${1:-}"; shift 2>/dev/null || true
    case "$sub" in
      checklist) security_checklist ;;
      asvs)      security_asvs "${1:-}" ;;
      owasp)     c="$(need "${1:-}" 'security owasp: needs a CWE id like CWE-89')"
                 for o in $(security_owasp_of "$c"); do printf '%s  %s\n' "$o" "$(security_owasp_name "$o")"; done
                 security_is_top25 "$c" && printf '%s is in the CWE Top 25\n' "$c"; true ;;
      cis)       security_cis "${1:-}" ;;
      top25)     security_top25 ;;
      *) die "security: expected checklist, asvs, owasp, cis, or top25" ;;
    esac
    ;;

  axioms)
    . "$ORCH_HOME/lib/axioms.sh"
    . "$ORCH_HOME/lib/escalate.sh"
    f="$(need "${1:-}" 'axioms: needs a feature')"; shift 2>/dev/null || true
    base="$(opt base "$(git -C "$ORCH_REPO" merge-base "$(escalate_base_branch)" HEAD 2>/dev/null || escalate_base_branch)" "$@")"
    found="$(axioms_scan "$base" HEAD)"
    if [ "$(printf '%s' "$found" | jq 'length')" = "0" ]; then
      printf 'no new escape hatches in %s (against %s).\n' "$f" "$(printf '%s' "$base" | cut -c1-12)"
      exit 0
    fi
    printf '%s' "$found" | jq -r '.[] | if .kind=="config"
      then "  CONFIG   \(.file)"
      else "  \(.file):\(.line)  \(.pattern)  (\(.base) -> \(.head))" end'
    printf '\nEach is a blocking finding at the tests-pass gate. Fix it, or dispute it with a reason.\n' >&2
    exit 1
    ;;

  spec)
    . "$ORCH_HOME/lib/spec.sh"
    sub="${1:-}"; shift 2>/dev/null || true
    f="$(need "${1:-}" 'spec: needs a feature')"; shift 2>/dev/null || true
    case "$sub" in
      coverage)
        cov="$(spec_coverage "$f" "$(opt sha "$(orch_head_sha)" "$@")")"
        if [ "$(printf '%s' "$cov" | jq 'length')" = "0" ]; then
          printf 'requirements.md for %s defines no requirement ids (R1, R2, ...), so nothing can cite one.\n' "$f"
          exit 0
        fi
        printf '%s' "$cov" | jq -r '.[] | "  \(.id)  " + (if (.tests|length)==0 then "UNCOVERED" else (.tests | join(", ")) end)'
        printf '%s' "$cov" | jq -e 'all(.[]; (.tests|length) > 0)' >/dev/null
        ;;
      *) die "spec: expected coverage" ;;
    esac
    ;;

  statement)
    . "$ORCH_HOME/lib/statement.sh"
    sub="${1:-}"; shift 2>/dev/null || true
    f="$(need "${1:-}" 'statement: needs a feature')"; shift 2>/dev/null || true
    case "$sub" in
      freeze) statement_freeze "$f" "$(opt why '' "$@")" ;;
      check)  statement_check "$f" && printf 'statement for %s is as frozen.\n' "$f" ;;
      show)   statement_frozen "$f" | jq '.' ;;
      *) die "statement: expected freeze, check, or show" ;;
    esac
    ;;

  oracle)
    . "$ORCH_HOME/lib/statement.sh"
    sub="${1:-}"; shift 2>/dev/null || true
    f="$(need "${1:-}" 'oracle: needs a feature')"; shift 2>/dev/null || true
    case "$sub" in
      freeze) oracle_freeze "$f" "$(opt sha "$(orch_head_sha)" "$@")" ;;
      check)  oracle_check "$f" "$(opt sha "$(orch_head_sha)" "$@")" && printf 'oracle for %s is as frozen.\n' "$f" ;;
      show)   oracle_frozen "$f" | jq '.' ;;
      *) die "oracle: expected freeze, check, or show" ;;
    esac
    ;;

  gate)
    . "$ORCH_HOME/lib/substrate/base.sh"
    sub="${1:-}"; shift 2>/dev/null || true
    f="$(need "${1:-}" 'gate: needs a feature')"; shift 2>/dev/null || true
    g="$(need "${1:-}" 'gate: needs a gate name')"; shift 2>/dev/null || true
    case "$sub" in
      read) substrate_read_gate "$f" "$g" | jq '.' ;;
      set)
        state="$(need "${1:-}" 'gate set: needs met or open')"; shift 2>/dev/null || true
        substrate_set_gate "$f" "$g" "$state" "$(opt sha "$(orch_head_sha)" "$@")"
        substrate_read_gate "$f" "$g" | jq '.'
        ;;
      check)
        st="$(substrate_read_gate "$f" "$g")"
        state="$(printf '%s' "$st" | jq -r '.state')"
        sha="$(printf '%s' "$st" | jq -r '.sha')"
        head="$(orch_head_sha)"
        ORCH_LEDGER_FEATURE="$f" ledger_append gate.checked gate "$g" state "$state"
        if [ "$state" != "met" ]; then
          printf 'gate %s for %s is %s\n' "$g" "$f" "$state" >&2
          ORCH_LEDGER_FEATURE="$f" ledger_append gate.blocked gate "$g" reason "state=$state"
          exit 1
        fi
        if [ -n "$sha" ] && [ "$sha" != "$head" ]; then
          printf 'gate %s for %s was met at %s but HEAD is now %s — approval does not carry across a moved branch tip\n' \
            "$g" "$f" "$(printf '%s' "$sha" | cut -c1-12)" "$(printf '%s' "$head" | cut -c1-12)" >&2
          ORCH_LEDGER_FEATURE="$f" ledger_append gate.blocked gate "$g" reason stale_sha
          exit 1
        fi
        printf 'gate %s for %s: met\n' "$g" "$f"
        ;;
      *) die "gate: expected read, set, or check" ;;
    esac
    ;;

  holdout)
    . "$ORCH_HOME/lib/holdout.sh"
    sub="${1:-}"; shift 2>/dev/null || true
    f="$(need "${1:-}" 'holdout: needs a feature')"; shift 2>/dev/null || true
    case "$sub" in
      add)  holdout_add "$f" "$(need "${1:-}" 'holdout add: needs a test path')" ;;
      list) holdout_list "$f" ;;
      run)  holdout_run "$f" "$@" ;;
      *) die "holdout: expected add, list, or run" ;;
    esac
    ;;

  readback)
    . "$ORCH_HOME/lib/readback.sh"
    sub="${1:-}"; shift 2>/dev/null || true
    f="$(need "${1:-}" 'readback: needs a feature')"; shift 2>/dev/null || true
    case "$sub" in
      start)
        # A code-reviewer with the readback lens: no write tools, sees the
        # oracle files and nothing else, and records through orch. Sonnet at
        # low effort — this is translation, not judgement.
        . "$ORCH_HOME/lib/launcher/base.sh"
        ( export ORCH_LENS=readback
          ORCH_LEDGER_FEATURE="$f" ORCH_EFFORT=low \
            ORCH_PROMPT="You are the read-back for $f. Run \`orch readback files $f\` and read ONLY those test files — requirements.md, request.md and contract.md are denied to you on purpose, and you must not infer what the tests are supposed to mean. For each test, write one plain-English paragraph stating exactly what would have to be true for it to pass: every input, every asserted output, every boundary, and what would satisfy it vacuously (an empty input, a caught exception, an assertion that cannot fail). Omitting a condition is the worst failure. Then record it: \`orch readback record $f -\` with the text on stdin. You change nothing." \
            launcher_spawn code-reviewer "$(launcher_session_name code-reviewer readback)" "$ORCH_REPO" \
              $(launcher_env code-reviewer "$f") )
        ;;
      record) readback_record "$f" "${1:--}" ;;
      files)  readback_files "$f" ;;
      show)   cat "$(readback_path "$f")" 2>/dev/null || { printf 'no read-back for %s\n' "$f"; exit 1; } ;;
      status) readback_status "$f"; printf '\n' ;;
      *) die "readback: expected start, record, files, show, or status" ;;
    esac
    ;;

  merge)
    . "$ORCH_HOME/lib/merge.sh"
    case "${1:-}" in
      status|'') merge_status ;;
      *) f="$1"; shift; merge_land "$f" "$@" ;;
    esac
    ;;

  waves)
    . "$ORCH_HOME/lib/waves.sh"
    ORCH_ROOT_BIN="$0"; export ORCH_ROOT_BIN
    case "${1:-}" in
      next) waves_next "${2:-}" ;;
      '')   waves_render ;;
      *) die "waves: expected nothing or next" ;;
    esac
    ;;

  packet)
    . "$ORCH_HOME/lib/packet.sh"
    packet_render "$(need "${1:-}" 'packet: needs a feature')"
    ;;

  approve)
    . "$ORCH_HOME/lib/substrate/base.sh"
    f="$(need "${1:-}" 'approve: needs a feature')"; shift
    g="$(opt gate human "$@")"
    sha="$(opt sha "$(orch_head_sha)" "$@")"
    substrate_set_gate "$f" "$g" met "$sha"
    [ "$g" != human ] || [ -n "${ORCH_PACKET_SEEN:-}" ] || \
      printf 'If you have not read it:  orch packet %s  — the statement and every check, before the diff.\n' "$f" >&2
    printf 'approved: %s gate `%s` at %s\n' "$f" "$g" "$(printf '%s' "$sha" | cut -c1-12)"
    printf 'This is durable and greppable, survives a dead session, and is scoped to that\nsha — move the branch and the approval stops applying.\n'
    ;;

  health)
    . "$ORCH_HOME/lib/health.sh"
    sub="${1:-}"; shift 2>/dev/null || true
    case "$sub" in
      signals)
        f="${1:-$(orch_current_feature)}"
        health_signals "$f" | jq '.'
        ;;
      observe)
        f="$(opt feature "$(orch_current_feature)" "$@")"
        k="$(opt kind '' "$@")"
        [ -n "$k" ] || die 'health observe: --kind is required'
        # Everything except --feature/--kind becomes an observation field.
        # This has to strip the flags it consumed rather than shifting a fixed
        # number of times: a blind shift leaves `--feature F --kind K` in the
        # argument list, and health_observe reads pairs positionally, so the
        # flag names themselves get written as field names and the values that
        # actually matter fall off the end.
        obs=()
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --feature|--kind) shift 2 2>/dev/null || shift ;;
            --feature=*|--kind=*) shift ;;
            --*=*) obs+=("${1%%=*}"); obs[${#obs[@]}-1]="${obs[${#obs[@]}-1]#--}"; obs+=("${1#*=}"); shift ;;
            --*) obs+=("${1#--}"); obs+=("${2-}"); shift 2 2>/dev/null || shift ;;
            *) shift ;;
          esac
        done
        health_observe "$f" "$k" "${obs[@]+"${obs[@]}"}"
        ;;
      *) die "health: expected signals or observe" ;;
    esac
    ;;

  escalate)
    . "$ORCH_HOME/lib/escalate.sh"
    sub="${1:-}"; shift 2>/dev/null || true
    case "$sub" in
      check) escalate_check "${1:-$(orch_current_feature)}" ;;
      rung)  escalate_rung "${1:-$(orch_current_feature)}"; printf '\n' ;;
      to)
        f="$(need "${1:-}" 'escalate to: needs a feature')"
        r="$(need "${2:-}" 'escalate to: needs a rung')"
        escalate_to "$f" "$r" "${3:-}"
        ;;
      *) die "escalate: expected check, rung, or to" ;;
    esac
    ;;

  findings)
    . "$ORCH_HOME/lib/findings.sh"
    sub="${1:-}"; shift 2>/dev/null || true
    case "$sub" in
      add)
        f="$(need "${1:-}" 'findings add: needs a feature')"; shift
        # Validate before calling, not inside the argument list: `die` inside a
        # command substitution kills only the subshell, so the caller would see
        # the complaint on stderr and a zero exit — which is how a tool ends up
        # printing an error and doing the thing anyway.
        claim="$(opt claim '' "$@")"
        cons="$(opt consequence '' "$@")"
        [ -n "$claim" ] || die 'findings add: --claim is required'
        [ -n "$cons" ]  || die 'findings add: --consequence is required — a finding with no stated consequence is an opinion'
        findings_add "$f" \
          "$(opt raised-by "$(orch_actor)" "$@")" \
          "$(opt severity major "$@")" \
          "$(opt file '' "$@")" \
          "$(opt line 0 "$@")" \
          "$claim" "$cons"
        ;;
      list)    findings_current "${1:-$(orch_current_feature)}" | jq -c '.' ;;
      deliver) findings_render_open "${1:-$(orch_current_feature)}" || { printf 'No open findings.\n'; exit 0; } ;;
      dispute)
        f="$(need "${1:-}" 'findings dispute: needs a feature')"; shift
        id="$(need "${1:-}" 'findings dispute: needs a finding id')"; shift
        reason="$(opt reason '' "$@")"
        [ -n "$reason" ] || die 'findings dispute: --reason is required — disputing without a reason is ignoring with extra steps'
        findings_set_status "$f" "$id" disputed "$reason"
        printf '%s disputed.\n' "$id"
        ;;
      verify)  findings_verify "${1:-$(orch_current_feature)}" ;;
      uptake)  findings_uptake "${1:-$(orch_current_feature)}" | jq '.' ;;
      yield)   findings_reviewer_yield "${1:---all}" | jq '.' ;;
      *) die "findings: expected add, list, deliver, dispute, verify, uptake, or yield" ;;
    esac
    ;;

  review)
    . "$ORCH_HOME/lib/findings.sh"
    sub="${1:-}"; shift 2>/dev/null || true
    case "$sub" in
      scope) findings_review_scope "${1:-$(orch_current_feature)}" ;;
      *) die "review: expected scope" ;;
    esac
    ;;

  upkeep)
    . "$ORCH_HOME/lib/layers.sh"; layer_require upkeep
    . "$ORCH_HOME/lib/upkeep.sh"
    ORCH_ROOT_BIN="$0"; export ORCH_ROOT_BIN
    sub="${1:-}"; shift 2>/dev/null || true
    case "$sub" in
      scan)    upkeep_render "$(upkeep_scan "$@")" ;;
      plan)    upkeep_plan "$@" ;;
      night)   upkeep_night "$@" ;;
      morning) upkeep_morning ;;
      telemetry) upkeep_telemetry "$@" ;;
      keep)    upkeep_keep "$(need "${1:-}" 'upkeep keep: needs a feature')" ;;
      discard) f="$(need "${1:-}" 'upkeep discard: needs a feature')"; shift; upkeep_discard "$f" "$(opt why '' "$@")" ;;
      *) die "upkeep: expected scan, plan, night, morning, telemetry, keep, or discard" ;;
    esac
    ;;

  product)
    . "$ORCH_HOME/lib/layers.sh"; layer_require product
    . "$ORCH_HOME/lib/product.sh"
    ORCH_ROOT_BIN="$0"; export ORCH_ROOT_BIN
    sub="${1:-}"; shift 2>/dev/null || true
    case "$sub" in
      trace)    product_trace ;;
      freeze)   product_freeze "$(opt why '' "$@")" ;;
      check)    product_check && printf 'product: as frozen\n' ;;
      personas) product_personas_render ;;
      metrics)  metrics_render ;;
      plan)     product_plan "$@" ;;
      night)    product_night "$@" ;;
      morning)  product_morning ;;
      keep)     f="$(need "${1:-}" 'product keep: needs a feature')"; shift; product_keep "$f" "$@" ;;
      iterate)  f="$(need "${1:-}" 'product iterate: needs a feature')"; shift; product_iterate "$f" "$@" ;;
      discard)  f="$(need "${1:-}" 'product discard: needs a feature')"; shift; product_discard "$f" "$@" ;;
      *) die "product: expected trace, freeze, check, personas, metrics, plan, night, morning, keep, iterate, or discard" ;;
    esac
    ;;

  walkthrough)
    . "$ORCH_HOME/lib/layers.sh"; layer_require product
    . "$ORCH_HOME/lib/walkthrough.sh"
    sub="${1:-}"; shift 2>/dev/null || true
    f="$(need "${1:-}" 'walkthrough: needs a feature')"; shift 2>/dev/null || true
    case "$sub" in
      start)
        # A code-reviewer with the walkthrough lens: no write tools; source,
        # tests and every feature artifact denied; records through orch.
        . "$ORCH_HOME/lib/launcher/base.sh"
        ( export ORCH_LENS=walkthrough
          ORCH_LEDGER_FEATURE="$f" ORCH_PROMPT="$(walkthrough_orders "$f")" \
            launcher_spawn code-reviewer "$(launcher_session_name code-reviewer walkthrough)" "$(orch_feature_repo "$f")" \
              $(launcher_env code-reviewer "$f") )
        ;;
      orders) walkthrough_orders "$f" ;;
      record) walkthrough_record "$f" "$(opt outcome '' "$@")" "$(opt steps '' "$@")" "$(opt minutes '' "$@")" "$(opt note '' "$@")" ;;
      status) walkthrough_render "$f" ;;
      *) die "walkthrough: expected start, record, status, or orders" ;;
    esac
    ;;

  refactor)
    . "$ORCH_HOME/lib/refactor.sh"
    sub="${1:-}"; shift 2>/dev/null || true
    f="$(need "${1:-}" 'refactor: needs a feature')"; shift 2>/dev/null || true
    case "$sub" in
      check)  refactor_should_run "$f" ;;
      start)
        refactor_start "$f"
        # A fresh context, on purpose: the developer that wrote the code is
        # anchored to why it wrote it that way. Same role, new session, cwd
        # in the worktree so the platform's worktree isolation applies.
        . "$ORCH_HOME/lib/launcher/base.sh"
        . "$ORCH_HOME/lib/tier.sh"
        ORCH_LEDGER_FEATURE="$f" ORCH_EFFORT="$(tier_effort "$(escalate_rung "$f")")" \
          ORCH_PROMPT="You are the refactor pass for $f — a fresh developer whose only job is design. Begin now: read docs/features/$f/REFACTOR.md in this worktree, then requirements.md, contract.md and the whole suite; improve the code without changing what it does; attest build and tests here with \`orch run\`; commit; then run \`orch refactor finish $f\`. The exit is mechanical and there is no repair loop." \
          launcher_spawn developer "$(launcher_session_name developer "refactor-$f")" "$(refactor_root "$f")" \
            $(launcher_env developer "$f") "ORCH_PHASE=refactor" || true
        ;;
      finish) refactor_finish "$f" ;;
      *) die "refactor: expected check, start, or finish" ;;
    esac
    ;;

  candidates)
    . "$ORCH_HOME/lib/candidates.sh"
    sub="${1:-}"; shift 2>/dev/null || true
    f="$(need "${1:-}" 'candidates: needs a feature')"; shift 2>/dev/null || true
    case "$sub" in
      start)   candidates_start "$f" "$(opt n "$ORCH_BEST_OF_N" "$@")" ;;
      collect) candidates_collect "$f" "$@" ;;
      select)  candidates_select "$f" ;;
      clean)   candidates_clean "$f" "$(opt keep '' "$@")" ;;
      list)    candidates_list "$f" ;;
      *) die "candidates: expected start, collect, select, clean, or list" ;;
    esac
    ;;

  diagnose)
    . "$ORCH_HOME/lib/diagnose.sh"
    sub="${1:-}"; shift 2>/dev/null || true
    f="$(need "${1:-}" 'diagnose: needs a feature')"; shift 2>/dev/null || true
    case "$sub" in
      start)   diagnose_start "$f" "$(need "${1:-}" 'diagnose start: needs a finding id')" "$(opt k "$ORCH_DIAGNOSE_K" "$@")" ;;
      predict)
        k="$(need "${1:-}" 'diagnose predict: needs a hypothesis number')"; shift
        diagnose_predict "$f" "$k" "$(opt prediction '' "$@")" "$(opt command '' "$@")"
        ;;
      run)     diagnose_run "$f" ;;
      show)    diagnose_current "$f" | jq -c '.' ;;
      *) die "diagnose: expected start, predict, run, or show" ;;
    esac
    ;;

  report)
    . "$ORCH_HOME/lib/report.sh"
    report_render "${1:---all}"
    ;;

  lab)
    # The experiment, kept in its own namespace so it never reads like a step
    # of the pipeline. Nothing here runs unless a human asks for it, and
    # nothing here merges.
    . "$ORCH_HOME/lib/report.sh"
    sub="${1:-}"; shift 2>/dev/null || true
    case "$sub" in
      baseline)
        f="$(need "${1:-}" 'lab baseline: needs a feature')"; shift
        report_baseline "$f" "$@"
        ;;
      ablation)
        rows=''
        for f in $([ "${1:---all}" = "--all" ] && report_features || printf '%s' "$1"); do
          rows="${rows}$(report_feature_json "$f")
"
        done
        if ! printf '%s' "$rows" | grep -v '^$' | jq -e -s 'any(.[]; .baseline != null)' >/dev/null 2>&1; then
          printf 'No baselines recorded, so there is nothing to compare against.\n\n'
          printf 'The ablation attempts a feature solo from the same requirements.md and\n'
          printf 'merges nothing. It costs a second full attempt per feature, which is why\n'
          printf 'it is opt-in:\n\n  orch lab baseline <feature> -- <gate command>\n\n'
          printf 'Run it on every feature, not only the ones that escalated — otherwise\n'
          printf 'escalation_precision has no denominator.\n'
          exit 0
        fi
        report_ablation_render "$rows"
        ;;
      *) die "lab: expected baseline or ablation" ;;
    esac
    ;;

  watch)
    . "$ORCH_HOME/lib/escalate.sh"
    . "$ORCH_HOME/lib/substrate/base.sh"
    # State comes from the ledger, the shared task list and the roster, so
    # this needs no terminal UI: it works over SSH, from a phone, and after the
    # session it is describing has died.
    while :; do
      clear 2>/dev/null || true
      printf 'orch watch — %s\n\n' "$(now_iso)"
      printf 'sessions:\n'
      substrate_roster | jq -r 'if length==0 then "  (none)" else .[] | "  \(.name // .sessionId)  pid=\(.pid)  \(.cwd)" end'
      printf '\nfeatures:\n'
      for f in $(orch_features_list); do
        orch_valid_feature "$f" || continue
        [ "$f" = "_orch" ] && continue
        printf '  %-22s rung %s (%s)  signals: %s\n' "$f" "$(escalate_rung "$f")" \
          "$(escalate_rung_name "$(escalate_rung "$f")")" \
          "$(. "$ORCH_HOME/lib/health.sh"; health_signals "$f" | jq -r '[.[].signal] | join(",") | if .=="" then "none" else . end')"
      done
      printf '\nrecent events:\n'
      ledger_read --all | tail -12 | jq -r '"  \(.ts)  \(.feature)  \(.event)  \(.reason // .label // .gate // "")"' 2>/dev/null
      [ "${ORCH_WATCH_ONCE:-0}" = "1" ] && break
      sleep "${ORCH_WATCH_INTERVAL:-5}"
    done
    ;;

  *) die "unknown command '$cmd' (try: $ORCH_PROG help)" ;;
esac
