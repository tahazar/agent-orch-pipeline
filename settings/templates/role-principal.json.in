{
  "_comment": "Rendered to settings/role-principal.json by build-prompts.sh. Principal reviews and NEVER modifies code, tests, or contracts. Edit is denied outright so the only way it can touch the tree is a whole-file Write, and the code roots are denied for that too. Its prompt says the same thing - this is the mechanical half.",
  "permissions": {
    "allow": [
      "Bash(pipeline:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
      "Bash(git rev-parse:*)", "Bash(git branch:*)",
      "Bash(npm test:*)", "Bash(npm run:*)", "Bash(pytest:*)", "Bash(make:*)",
      "Bash(cargo test:*)", "Bash(go test:*)",
      "Read", "Glob", "Grep"
    ],
    "deny": [
      "Edit", "NotebookEdit",
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git merge:*)",
      "Bash(git rebase:*)", "Bash(git checkout:*)", "Bash(git push:*)", "Bash(gh:*)",
      "Write(**/src/**)", "Write(**/lib/**)", "Write(**/app/**)", "Write(**/pkg/**)",
      "Write(**/test/**)", "Write(**/tests/**)", "Write(**/__tests__/**)",
      "Write(**/CLAUDE.md)", "Write(**/AGENTS.md)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "@@INSTALL_DIR@@/hooks/pane-state.sh running" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "@@INSTALL_DIR@@/hooks/pane-state.sh running" }] }
    ],
    "Notification": [
      { "hooks": [
        { "type": "command", "command": "@@INSTALL_DIR@@/hooks/pane-state.sh waiting" },
        { "type": "command", "command": "@@INSTALL_DIR@@/hooks/notify-developer.sh" }
      ] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "@@INSTALL_DIR@@/hooks/pane-state.sh done" }] }
    ]
  }
}
