{
  "_comment": "Rendered to settings/role-inspector.json by build-prompts.sh. The inspector audits tests and reviews implementations; it never fixes either. Edit is denied outright, and the code roots are denied for Write, so its only output is review documents.",
  "permissions": {
    "allow": [
      "Bash(pipeline:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(npm test:*)", "Bash(npm run:*)", "Bash(pytest:*)", "Bash(make:*)",
      "Bash(cargo test:*)", "Bash(go test:*)",
      "Read", "Glob", "Grep"
    ],
    "deny": [
      "Edit", "NotebookEdit",
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git push:*)", "Bash(gh:*)",
      "Bash(git merge:*)", "Bash(git rebase:*)", "Bash(git checkout:*)",
      "Write(**/src/**)", "Write(**/lib/**)", "Write(**/app/**)", "Write(**/pkg/**)",
      "Write(**/test/**)", "Write(**/tests/**)", "Write(**/__tests__/**)",
      "Write(**/contracts.*)", "Write(**/types/contracts*)",
      "Write(**/CLAUDE.md)", "Write(**/AGENTS.md)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "@@INSTALL_DIR@@/hooks/pane-state.sh running" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "@@INSTALL_DIR@@/hooks/pane-state.sh running" }] }
    ],
    "Notification": [
      { "hooks": [
        { "type": "command", "command": "@@INSTALL_DIR@@/hooks/pane-state.sh waiting" },
        { "type": "command", "command": "@@INSTALL_DIR@@/hooks/notify-developer.sh" }
      ] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "@@INSTALL_DIR@@/hooks/pane-state.sh done" }] }
    ]
  }
}
